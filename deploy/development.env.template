# Railway environment: development  (branch: develop, domain: dev.<your-domain>)
# Template only — no secrets here. Set these in Railway → environment "development" →
# service "web" → Variables. ${{...}} are Railway reference variables.
APP_ENV=development
L27_MODE=mock
MOCK_PASSWORD=<choose a shared test password>
NOTIFICATIONS_MODE=sandbox
INBOX_SIMULATOR=true
SAMPLE_DATA=true
SESSION_SECRET=<32+ random chars, unique to this environment>
DATABASE_URL=${{Postgres.DATABASE_URL}}
LOG_LEVEL=debug
ADMIN_EMAILS=<comma-separated>
# RINGCENTRAL_SERVER=https://platform.devtest.ringcentral.com
# RINGCENTRAL_CLIENT_ID=<sandbox app client id>
