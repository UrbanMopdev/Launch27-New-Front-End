# Railway environment: staging / QA  (branch: staging, domain: qa.<your-domain>)
# Template only — no secrets here. Mirrors production settings except data and integrations,
# which are synthetic/sandbox.
APP_ENV=staging
L27_MODE=mock
MOCK_PASSWORD=<choose a shared QA password>
NOTIFICATIONS_MODE=sandbox
INBOX_SIMULATOR=true
SAMPLE_DATA=true
SESSION_SECRET=<32+ random chars, unique to this environment>
DATABASE_URL=${{Postgres.DATABASE_URL}}
LOG_LEVEL=info
ADMIN_EMAILS=<comma-separated>
# RINGCENTRAL_SERVER=https://platform.devtest.ringcentral.com
# RINGCENTRAL_CLIENT_ID=<sandbox app client id>
# Receive anonymized copies of real data from production (same value as production).
QA_SNAPSHOT_TOKEN=<32+ random chars, shared with production>
