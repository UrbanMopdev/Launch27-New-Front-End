# Railway environment: production  (branch: main, domain: app.<your-domain>)
# Template only — no secrets here. The server refuses to start in production unless
# SESSION_SECRET (32+ chars) and DATABASE_URL are set, L27_MODE is live and the
# simulator is off.
APP_ENV=production
L27_MODE=live
L27_BASE_URL=https://urbanmop.launch27.com
L27_ALLOW_WRITES=<true only once the team is ready to edit bookings from this app>
NOTIFICATIONS_MODE=<sandbox until real channel connectors ship; then live>
INBOX_SIMULATOR=false
SESSION_SECRET=<32+ random chars, unique to production>
DATABASE_URL=${{Postgres.DATABASE_URL}}
LOG_LEVEL=info
ADMIN_EMAILS=<comma-separated>
# RINGCENTRAL_SERVER=https://platform.ringcentral.com
# RINGCENTRAL_CLIENT_ID=<production app client id>
