# Launch27 tenant
L27_BASE_URL=https://urbanmop.launch27.com

# Server
PORT=8787
# Random string used to sign the session cookie
SESSION_SECRET=change-me
# The proxy only forwards GET requests unless this is true. Leave it off until
# a page actually needs to write to Launch27.
L27_ALLOW_WRITES=false

# Capture tool only (npm run capture): the admin login it crawls with.
# Optional: without them the browser opens and you log in by hand.
L27_EMAIL=
L27_PASSWORD=
