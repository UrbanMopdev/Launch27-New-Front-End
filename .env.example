# Local development settings. Copy to .env (gitignored) and fill in.
# Hosted environments (development / staging / production on Railway) do NOT use this file:
# their variables are set per environment in Railway. See docs/environments.md and the
# templates in deploy/.
# Wrap values containing # in single quotes, e.g. L27_PASSWORD='abc#123'.

# ---------- Environment ----------
# development | staging | production. On Railway this comes from RAILWAY_ENVIRONMENT_NAME.
APP_ENV=development
PORT=8787
# debug | info | warn | error. Logs are JSON with emails, phones and secrets redacted.
LOG_LEVEL=info

# ---------- Launch27 ----------
# live: the real Launch27 at L27_BASE_URL (read-only outside production).
# mock: built-in synthetic Launch27 (fake customers, cleaners, bookings). Forced on Railway
#       dev/staging so they can never touch real customer data.
L27_MODE=mock
L27_BASE_URL=https://urbanmop.launch27.com
# Sign-in password for every account in mock mode (any email works).
MOCK_PASSWORD=demo
# Production only. Ignored (forced off) in development/staging when L27_MODE=live.
L27_ALLOW_WRITES=false

# ---------- Sessions ----------
# At least 32 random characters in hosted environments. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out.
SESSION_SECRET=change-me-locally

# ---------- Database ----------
# Postgres URL. Empty locally = embedded Postgres (PGlite) in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=.data/pglite
DATABASE_POOL_MAX=10
# Apply pending migrations when the server starts. Railway runs them as a pre-deploy
# step instead (railway.json), so this is harmless there.
MIGRATE_ON_BOOT=true

# ---------- Notifications ----------
# sandbox: outbound SMS/email is recorded but never sent. Forced outside production.
NOTIFICATIONS_MODE=sandbox
# Channel simulator page + POST /api/simulate/inbound. Off by default in production.
INBOX_SIMULATOR=true
# RingCentral Embeddable softphone. Outside production only the sandbox server is allowed
# (https://platform.devtest.ringcentral.com); a production server URL disables the phone.
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_SERVER=

# ---------- Support workspace ----------
# Comma-separated. The first person to sign in also becomes an admin.
ADMIN_EMAILS=
SUPERVISOR_EMAILS=

# ---------- Capture tool only (npm run capture) ----------
# The admin login it crawls the real portal with. Never used by the server.
L27_EMAIL=
L27_PASSWORD=
