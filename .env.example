# Launch27 tenant
L27_BASE_URL=https://urbanmop.launch27.com

# Server
PORT=8787
# Random string used to sign the session cookie
SESSION_SECRET=change-me
# The proxy only forwards GET requests unless this is true. Leave it off until
# a page actually needs to write to Launch27.
L27_ALLOW_WRITES=false

# Capture tool only (npm run capture): the admin login it crawls with.
# Optional: without them the browser opens and you log in by hand.
# Wrap values containing # in single quotes, e.g. L27_PASSWORD='abc#123'.
L27_EMAIL=
L27_PASSWORD=

# ---------- Support workspace ----------
# Postgres for conversations, contacts, routing and audit. On Railway, add a Postgres
# service and reference its DATABASE_URL here. Without it the server uses an embedded
# Postgres (PGlite) in PGLITE_DIR, which is fine for local dev but not for production.
DATABASE_URL=
PGLITE_DIR=.data/pglite
# Comma-separated. The first person to sign in also becomes an admin.
ADMIN_EMAILS=leslie@urbanmop.ca
SUPERVISOR_EMAILS=
# Phase 1 test traffic: POST /api/simulate/inbound and the Channel simulator page.
INBOX_SIMULATOR=true
# RingCentral Embeddable (in-app softphone). Register an app in the RingCentral developer
# console and put its client ID here; the phone widget only loads when this is set.
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_SERVER=
