{
  "name": "launch27-new-front-end",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web",
    "capture"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm start -w server",
    "test": "npm test -w server -w capture -w web",
    "capture": "npm start -w capture --",
    "catalog": "npm run catalog -w capture",
    "lint": "eslint .",
    "typecheck": "npm run typecheck -w web",
    "migrate": "npm run migrate -w server",
    "migrate:status": "npm run migrate:status -w server",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=22"
  }
}
