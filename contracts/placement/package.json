{
  "name": "placement-contract",
  "version": "1.1.0",
  "description": "The API every front end app implements so the Sales Hub can quote, find slots, hold and book",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./conformance": "./conformance.js",
    "./openapi.yaml": "./openapi.yaml"
  },
  "bin": {
    "placement-conformance": "./cli.js"
  },
  "scripts": {
    "test": "node --test 'test/*.test.js'",
